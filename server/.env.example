PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/landsolutions
NODE_ENV=development

# Optional: Set to true to run server without database
ALLOW_NO_DB=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Firebase Configuration (for file storage)
FIREBASE_PROJECT_ID=landsolutions
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@landsolutions.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# External API Keys
DEEDS_API_KEY=your-deeds-office-api-key
GIS_API_KEY=your-gis-mapping-api-key
VERIFICATION_API_KEY=your-verification-api-key
